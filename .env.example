# =============================================================
# Active provider
# =============================================================
# Switching provider normally means editing only this block.

# openai | anthropic | gemini | openai_compatible | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# openai | sentence_transformers
# These are the only two embedding backends. Chat and embeddings
# are chosen independently, so a non-OpenAI chat provider still
# needs one of these for retrieval.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small


# =============================================================
# Per-workflow model overrides (optional)
# =============================================================
# Leave blank to inherit LLM_MODEL. Set one only to tune cost or
# quality for that single step. Anything set here must be a model
# that exists on the LLM_PROVIDER selected above.

DISCOVERY_QUERY_MODEL=
DISCOVERY_RANK_MODEL=
ANALYSIS_MODEL=
CHAT_MODEL=
COMPARE_PROFILE_MODEL=
# Previously pinned to gpt-4o: a stronger model for the final
# cross-paper synthesis. Set it again if you want that behaviour.
COMPARE_SYNTHESIS_MODEL=
IDEA_GENERATION_MODEL=
IDEA_CRITIQUE_MODEL=
IMPLEMENTATION_EXTRACTION_MODEL=
IMPLEMENTATION_CODE_MODEL=
IMPLEMENTATION_REVIEW_MODEL=


# =============================================================
# Provider presets
# =============================================================
# Replace the "Active provider" block above with one of these.
# Check your provider's current model list for the model id --
# the names below are illustrative, not guaranteed to be current.
#
# --- Anthropic (needs ANTHROPIC_API_KEY) ---------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# --- Gemini (needs GOOGLE_API_KEY) ---------------------------
# LLM_PROVIDER=gemini
# LLM_MODEL=<gemini-model-id>
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# --- OpenAI-compatible (Groq, Together, OpenRouter, vLLM) -----
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=<model-id-on-that-service>
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
#
# --- Ollama, fully local, no API key -------------------------
# LLM_PROVIDER=ollama
# LLM_MODEL=<a model you have pulled, e.g. gemma3:4b>
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# =============================================================
# Credentials
# =============================================================
# Only the ones for your selected provider are required.

OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: override the OpenAI transport endpoint.
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

GOOGLE_API_KEY=

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

OLLAMA_BASE_URL=http://localhost:11434

# Optional: cpu, cuda, mps. Blank lets sentence-transformers choose.
LOCAL_EMBEDDING_DEVICE=


# =============================================================
# Notes
# =============================================================
# - Changes here require a backend restart. Settings are read once
#   at import and the provider clients are cached for the process
#   lifetime, and .env sits outside the --reload watch directory.
# - Switching EMBEDDING_PROVIDER or EMBEDDING_MODEL does not mix
#   vector spaces: Chroma collections are namespaced per backend.
#   Existing papers report "stale" until re-embedded via
#   POST /papers/reembed.
# - GET /health/details only checks that required settings are
#   non-empty. It cannot tell a valid key from a placeholder.
